# Local MinIO administrator account. Replace these values in your local .env.
MINIO_ROOT_USER=skill_observatory
MINIO_ROOT_PASSWORD=change-this-local-password

# S3-compatible settings used by the Python storage module.
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=skill_observatory
S3_SECRET_KEY=change-this-local-password
S3_BUCKET=skill-observatory
S3_REGION=us-east-1
S3_USE_SSL=false
